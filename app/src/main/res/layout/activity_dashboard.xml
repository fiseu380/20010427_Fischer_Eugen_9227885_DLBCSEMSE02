<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clDashboardMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        tools:context=".ui.DashboardActivity">

        <!-- =========================================================== -->
        <!-- HEADER SECTION: Title, Goal and Countdown                   -->
        <!-- =========================================================== -->

        <LinearLayout
            android:id="@+id/llHeaderSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_tv_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDashboardGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Writing Thesis" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/grey" />

                <TextView
                    android:id="@+id/tvDashboardCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="30 days left" />
            </LinearLayout>

        </LinearLayout>
        <!-- =========================================================== -->
        <!-- POMODORO WIDGET                                             -->
        <!-- =========================================================== -->
        <include
            android:id="@+id/pomodoroWidget"
            layout="@layout/layout_pomodoro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llHeaderSection" />

        <!-- =========================================================== -->
        <!-- PROGRESS SECTION: Target and Time Bars                      -->
        <!-- =========================================================== -->
        <include
            android:id="@+id/includeProgress"
            layout="@layout/layout_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pomodoroWidget" />

        <!-- =========================================================== -->
        <!-- ACTION SECTION: History and Reset Goal                      -->
        <!-- =========================================================== -->

        <Button
            android:id="@+id/btnDashboardHistory"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/dashboard_btn_history"
            android:textAllCaps="false"
            android:textColor="@color/grey"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnAddTargetProgress"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/includeProgress"
            app:layout_constraintVertical_bias="1.0" />

        <Button
            android:id="@+id/btnAddTargetProgress"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_btn_add_progress"
            android:textAllCaps="false"
            android:textColor="@color/grey"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnDashboardHistory"
            app:layout_constraintEnd_toStartOf="@+id/btnDashboardNewGoal"
            app:layout_constraintStart_toEndOf="@+id/btnDashboardHistory"
            app:layout_constraintTop_toTopOf="@+id/btnDashboardHistory" />

        <Button
            android:id="@+id/btnDashboardNewGoal"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="@string/dashboard_btn_new_goal"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnDashboardHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnAddTargetProgress"
            app:layout_constraintTop_toTopOf="@+id/btnDashboardHistory" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>